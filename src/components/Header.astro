---
import { siteConfig } from '../config/site';
import {
  getTranslations,
  localizedPath,
  switchLocalePath,
  type Locale,
  locales,
} from '../i18n';

interface Props {
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const t = getTranslations(locale);
const currentPath = Astro.url.pathname;

const navItems = [
  { href: localizedPath(locale, '/about'), label: t.nav.about, key: 'about' },
  { href: localizedPath(locale, '/projects'), label: t.nav.projects, key: 'projects' },
  { href: localizedPath(locale, '/notes'), label: t.nav.notes, key: 'notes' },
  { href: localizedPath(locale, '/experience'), label: t.nav.experience, key: 'experience' },
  { href: localizedPath(locale, '/contact'), label: t.nav.contact, key: 'contact' },
];

function langHref(targetLocale: Locale) {
  return alternates?.[targetLocale] ?? switchLocalePath(locale, targetLocale, currentPath);
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href={localizedPath(locale)} class="site-logo">{siteConfig.name}</a>

    <button
      type="button"
      class="nav-toggle"
      aria-expanded="false"
      aria-controls="site-nav"
    >
      {t.a11y.menu}
    </button>

    <nav class="lang-switch" aria-label={t.a11y.languageSwitcher}>
      {
        locales.map((loc, index) => (
          <>
            {index > 0 && <span aria-hidden="true">|</span>}
            <a
              href={langHref(loc)}
              hreflang={loc === 'pt-br' ? 'pt-BR' : 'en'}
              aria-current={locale === loc ? 'page' : undefined}
            >
              {loc === 'en' ? t.lang.en : t.lang.ptBr}
            </a>
          </>
        ))
      }
    </nav>

    <nav class="site-nav" id="site-nav" aria-label={t.a11y.mainNav}>
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  currentPath === item.href ||
                  (item.key !== 'home' && currentPath.startsWith(item.href))
                    ? 'page'
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.nav-toggle');
  const nav = document.querySelector('.site-nav');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('is-open');
  });
</script>
